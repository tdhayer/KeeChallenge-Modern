<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputPath>bin\$(PlatformTarget)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\KeeChallenge\src\KeeChallenge.csproj" GlobalPropertiesToRemove="PlatformTarget" />
    <Reference Include="KeePass">
      <HintPath>..\..\KeeChallenge\lib\KeePass.exe</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
