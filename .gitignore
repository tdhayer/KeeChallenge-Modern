################
## Visual Studio
################

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
build/
[Bb]in/
[Oo]bj/

# ReSharper: a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper

# DotCover: a code coverage tool
*.dotCover

# NuGet packages directory
packages/

# Others
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
*.log

# Ignore backup & report files from converting an old project file to a newer
# Visual Studio version. Backup files would not be needed, because we use git.
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

###################
## Windows detritus
###################

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

###################
## Mac detritus
###################

# Mac junk
.DS_Store

###################
## Binaries
###################

*.exe
*.dll
*.plgx
*.lscache
# Ignore .secret-stack folder
.secret-stack
MODERNIZATION_PLAN.md
ROADMAP.md
future-roadmap.md
security-hardening-roadmap.md

# Local manual validation sandbox artifacts
test-sandbox/

# Local scratch / release-artifact diffing dir
.tmp/

# Local editor/workstation config
.vscode/

# Local validation run snapshots
docs/p0-validation-results-*.md
